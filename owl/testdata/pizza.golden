Prefix(:=<http://example.org/pizza#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)

Ontology(<http://example.org/pizza> <http://example.org/pizza/1.0>
    Annotation(rdfs:comment "A pizza ontology, for tests."@en)
    Declaration(Class(:Food))
    Declaration(Class(:Pizza))
    Declaration(Class(:Topping))
    Declaration(Class(:MeatTopping))
    Declaration(Class(:VegetarianPizza))
    Declaration(ObjectProperty(:hasTopping))
    Declaration(ObjectProperty(:hasBase))
    Declaration(DataProperty(:calories))
    Declaration(NamedIndividual(:margherita))
    AnnotationAssertion(rdfs:label :Pizza "Pizza"@en)
    AnnotationAssertion(rdfs:label :Topping "Topping"@en)
    SubClassOf(:Topping :Food)
    SubClassOf(:MeatTopping :Topping)
    SubClassOf(:Pizza :Food)
    SubClassOf(:Pizza ObjectSomeValuesFrom(:hasTopping :Topping))
    SubClassOf(:Pizza ObjectExactCardinality(1 :hasBase))
    SubClassOf(:Pizza DataSomeValuesFrom(:calories DatatypeRestriction(xsd:integer xsd:minInclusive "0"^^xsd:integer)))
    EquivalentClasses(:VegetarianPizza ObjectIntersectionOf(:Pizza ObjectAllValuesFrom(:hasTopping ObjectComplementOf(:MeatTopping))))
    DisjointClasses(:Pizza :Topping)
    ObjectPropertyDomain(:hasTopping :Pizza)
    ObjectPropertyRange(:hasTopping :Topping)
    FunctionalObjectProperty(:hasBase)
    FunctionalDataProperty(:calories)
    HasKey(:Pizza (:hasBase) ())
    ClassAssertion(:Pizza :margherita)
    DataPropertyAssertion(:calories :margherita "800"^^xsd:integer)
)
