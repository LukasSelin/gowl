    Annotation(dc:title "The RDF Schema vocabulary (RDFS)"^^xsd:string)
    Annotation(rdfs:seeAlso <http://www.w3.org/2000/01/rdf-schema-more>)
    AnnotationAssertion(rdfs:comment rdfs:Class "The class of classes."^^xsd:string)
    AnnotationAssertion(rdfs:comment rdfs:Container "The class of RDF containers."^^xsd:string)
    AnnotationAssertion(rdfs:comment rdfs:ContainerMembershipProperty "The class of container membership properties, rdf:_1, rdf:_2, ..., all of which are sub-properties of 'member'."^^xsd:string)
    AnnotationAssertion(rdfs:comment rdfs:Datatype "The class of RDF datatypes."^^xsd:string)
    AnnotationAssertion(rdfs:comment rdfs:Literal "The class of literal values, eg. textual strings and integers."^^xsd:string)
    AnnotationAssertion(rdfs:comment rdfs:Resource "The class resource, everything."^^xsd:string)
    AnnotationAssertion(rdfs:comment rdfs:comment "A description of the subject resource."^^xsd:string)
    AnnotationAssertion(rdfs:comment rdfs:domain "A domain of the subject property."^^xsd:string)
    AnnotationAssertion(rdfs:comment rdfs:isDefinedBy "The definition of the subject resource."^^xsd:string)
    AnnotationAssertion(rdfs:comment rdfs:label "A human-readable name for the subject."^^xsd:string)
    AnnotationAssertion(rdfs:comment rdfs:member "A member of the subject resource."^^xsd:string)
    AnnotationAssertion(rdfs:comment rdfs:range "A range of the subject property."^^xsd:string)
    AnnotationAssertion(rdfs:comment rdfs:seeAlso "Further information about the subject resource."^^xsd:string)
    AnnotationAssertion(rdfs:comment rdfs:subClassOf "The subject is a subclass of a class."^^xsd:string)
    AnnotationAssertion(rdfs:comment rdfs:subPropertyOf "The subject is a subproperty of a property."^^xsd:string)
