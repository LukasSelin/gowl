Prefix(dct:=<http://purl.org/dc/terms/>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(skos:=<http://www.w3.org/2004/02/skos/core#>)
Prefix(time:=<http://www.w3.org/2006/time#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)

Ontology(<http://www.w3.org/2006/time> <http://www.w3.org/2006/time#2016>
    Annotation(dct:contributor <mailto:chris.little@metoffice.gov.uk>)
    Annotation(dct:contributor <https://orcid.org/0000-0001-8269-8171>)
    Annotation(dct:created "2006-09-27"^^xsd:date)
    Annotation(dct:creator <http://orcid.org/0000-0002-3884-3420>)
    Annotation(dct:creator <https://en.wikipedia.org/wiki/Jerry_Hobbs>)
    Annotation(dct:creator <mailto:panfeng66@gmail.com>)
    Annotation(dct:isVersionOf <http://www.w3.org/TR/owl-time>)
    Annotation(dct:license <https://creativecommons.org/licenses/by/4.0/>)
    Annotation(dct:modified "2017-04-06"^^xsd:date)
    Annotation(dct:rights "Copyright © 2006-2017 W3C, OGC. W3C and OGC liability, trademark and document use rules apply."@en)
    Annotation(rdfs:label "OWL-Time"@en)
    Annotation(rdfs:label "Tiempo en OWL"@es)
    Annotation(rdfs:seeAlso <http://dx.doi.org/10.3233/SW-150187>)
    Annotation(rdfs:seeAlso <http://www.semantic-web-journal.net/content/time-ontology-extended-non-gregorian-calendar-applications>)
    Annotation(rdfs:seeAlso <http://www.w3.org/TR/owl-time>)
    Annotation(owl:priorVersion time:2006)
    Annotation(skos:changeNote "2016-06-15 - initial update of OWL-Time - modified to support arbitrary temporal reference systems. "^^xsd:string)
    Annotation(skos:changeNote "2016-12-20 - adjust range of time:timeZone to time:TimeZone, moved up from the tzont ontology.  "^^xsd:string)
    Annotation(skos:changeNote "2016-12-20 - restore time:Year and time:January which were present in the 2006 version of the ontology, but now marked \"deprecated\". "^^xsd:string)
    Annotation(skos:changeNote "2017-02 - intervalIn, intervalDisjoint, monthOfYear added; TemporalUnit subclass of TemporalDuration"^^xsd:string)
    Annotation(skos:changeNote "2017-04-06 - hasTime, hasXSDDuration added; Number removed; all duration elements changed to xsd:decimal"^^xsd:string)
    Annotation(skos:historyNote "Update of OWL-Time ontology, extended to support general temporal reference systems. \n\nOntology engineering by Simon J D Cox"@en)
    AnnotationAssertion(rdfs:comment time:DateTimeDescription "Descripción de fecha y tiempo estructurada con valores separados para los diferentes elementos de un sistema calendario-reloj. El sistema de referencia temporal está fijado al calendario gregoriano, y el rango de las propiedades año, mes, día restringidas a los correspondientes tipos del XML Schema xsd:gYear, xsd:gMonth y xsd:gDay respectivamente."@es)
    AnnotationAssertion(rdfs:comment time:DateTimeDescription "Description of date and time structured with separate values for the various elements of a calendar-clock system. The temporal reference system is fixed to Gregorian Calendar, and the range of year, month, day properties restricted to corresponding XML Schema types xsd:gYear, xsd:gMonth and xsd:gDay, respectively."@en)
    AnnotationAssertion(rdfs:comment time:DateTimeInterval "'intervalo de fecha-hora' es una subclase de 'intervalo propio', definida utilizando el multi-elemento 'descripción de fecha-hora'."@es)
    AnnotationAssertion(rdfs:comment time:DateTimeInterval "DateTimeInterval is a subclass of ProperInterval, defined using the multi-element DateTimeDescription."@en)
    AnnotationAssertion(rdfs:comment time:DayOfWeek "El día de la semana"@es)
    AnnotationAssertion(rdfs:comment time:DayOfWeek "The day of week"@en)
    AnnotationAssertion(rdfs:comment time:Duration "Duración de una extensión temporal expresada como un número escalado por una unidad temporal."@es)
    AnnotationAssertion(rdfs:comment time:Duration "Duration of a temporal extent expressed as a number scaled by a temporal unit"@en)
    AnnotationAssertion(rdfs:comment time:DurationDescription "Descripción de extensión temporal estructurada con valores separados para los distintos elementos de un sistema de horario-calendario. El sistema de referencia temporal se fija al calendario gregoriano, y el intervalo de cada una de las propiedades numéricas se restringe a xsd:decimal."@es)
    AnnotationAssertion(rdfs:comment time:DurationDescription "Description of temporal extent structured with separate values for the various elements of a calendar-clock system. The temporal reference system is fixed to Gregorian Calendar, and the range of each of the numeric properties is restricted to xsd:decimal"@en)
    AnnotationAssertion(rdfs:comment time:GeneralDateTimeDescription "Descripción de fecha y hora estructurada con valores separados para los distintos elementos de un sistema calendario-reloj."@es)
    AnnotationAssertion(rdfs:comment time:GeneralDateTimeDescription "Description of date and time structured with separate values for the various elements of a calendar-clock system"@en)
    AnnotationAssertion(rdfs:comment time:GeneralDurationDescription "Descripción de extensión temporal estructurada con valores separados para los distintos elementos de un sistema de horario-calendario."@es)
    AnnotationAssertion(rdfs:comment time:GeneralDurationDescription "Description of temporal extent structured with separate values for the various elements of a calendar-clock system."@en)
    AnnotationAssertion(rdfs:comment time:Instant "A temporal entity with zero extent or duration"@en)
    AnnotationAssertion(rdfs:comment time:Instant "Una entidad temporal con una extensión o duración cero."@es)
    AnnotationAssertion(rdfs:comment time:Interval "A temporal entity with an extent or duration"@en)
    AnnotationAssertion(rdfs:comment time:Interval "Una entidad temporal con una extensión o duración."@es)
    AnnotationAssertion(rdfs:comment time:MonthOfYear "El mes del año."@es)
    AnnotationAssertion(rdfs:comment time:MonthOfYear "The month of the year"@en)
    AnnotationAssertion(rdfs:comment time:ProperInterval "A temporal entity with non-zero extent or duration, i.e. for which the value of the beginning and end are different"@en)
    AnnotationAssertion(rdfs:comment time:ProperInterval "Una entidad temporal con extensión o duración distinta de cero, es decir, para la cual los valores de principio y fin del intervalo son diferentes."@es)
    AnnotationAssertion(rdfs:comment time:TRS "A temporal reference system, such as a temporal coordinate system (with an origin, direction, and scale), a calendar-clock combination, or a (possibly hierarchical) ordinal system. \n\nThis is a stub class, representing the set of all temporal reference systems."@en)
    AnnotationAssertion(rdfs:comment time:TRS "Un sistema de referencia temporal, tal como un sistema de coordenadas temporales (con un origen, una dirección y una escala), una combinación calendario-reloj, o un sistema ordinal (posiblemente jerárquico).\n        Esta clase comodín representa el conjunto de todos los sistemas de referencia temporal."@es)
    AnnotationAssertion(rdfs:comment time:TemporalDuration "Extensión de tiempo; duración de un intervalo de tiempo independiente de su posición de inicio particular."@es)
    AnnotationAssertion(rdfs:comment time:TemporalDuration "Time extent; duration of a time interval separate from its particular start position"@en)
    AnnotationAssertion(rdfs:comment time:TemporalEntity "A temporal interval or instant."@en)
    AnnotationAssertion(rdfs:comment time:TemporalEntity "Un intervalo temporal o un instante."@es)
    AnnotationAssertion(rdfs:comment time:TemporalPosition "A position on a time-line"@en)
    AnnotationAssertion(rdfs:comment time:TemporalPosition "Una posición sobre una línea de tiempo."@es)
    AnnotationAssertion(rdfs:comment time:TemporalUnit "A standard duration, which provides a scale factor for a time extent, or the granularity or precision for a time position."@en)
    AnnotationAssertion(rdfs:comment time:TemporalUnit "Una duración estándar, que proporciona un factor de escala para una extensión de tiempo, o la granularidad o precisión para una posición de tiempo."@es)
    AnnotationAssertion(rdfs:comment time:TimePosition "A temporal position described using either a (nominal) value from an ordinal reference system, or a (numeric) value in a temporal coordinate system. "@en)
    AnnotationAssertion(rdfs:comment time:TimePosition "Una posición temporal descrita utilizando bien un valor (nominal) de un sistema de referencia ordinal, o un valor (numérico) en un sistema de coordenadas temporales."@es)
    AnnotationAssertion(rdfs:comment time:TimeZone "A Time Zone specifies the amount by which the local time is offset from UTC. \n\tA time zone is usually denoted geographically (e.g. Australian Eastern Daylight Time), with a constant value in a given region. \nThe region where it applies and the offset from UTC are specified by a locally recognised governing authority."@en)
    AnnotationAssertion(rdfs:comment time:TimeZone "Un huso horario especifica la cantidad en que la hora local está desplazada con respecto a UTC.\n        Un huso horario normalmente se denota geográficamente (p.ej. el horario de verano del este de Australia), con un valor constante en una región dada.\n        La región donde aplica y el desplazamiento desde UTC las especifica una autoridad gubernamental localmente reconocida."@es)
    AnnotationAssertion(rdfs:comment time:Year "Year duration"^^xsd:string)
    AnnotationAssertion(rdfs:comment time:after "Asume una dirección en el tiempo. Si una entidad temporal T1 está después de otra entidad temporal T2, entonces el principio de T1 está después del final de T2."@es)
    AnnotationAssertion(rdfs:comment time:after "Gives directionality to time. If a temporal entity T1 is after another temporal entity T2, then the beginning of T1 is after the end of T2."@en)
    AnnotationAssertion(rdfs:comment time:before "Asume una dirección en el tiempo. Si una entidad temporal T1 está antes que otra entidad temporal T2, entonces el final de T1 está antes que el principio de T2. Así, \"antes\" se puede considerar básica para instantes y derivada para intervalos."@es)
    AnnotationAssertion(rdfs:comment time:before "Gives directionality to time. If a temporal entity T1 is before another temporal entity T2, then the end of T1 is before the beginning of T2. Thus, \"before\" can be considered to be basic to instants and derived for intervals."@en)
    AnnotationAssertion(rdfs:comment time:day "Day position in a calendar-clock system.\n\nThe range of this property is not specified, so can be replaced by any specific representation of a calendar day from any calendar. "@en)
    AnnotationAssertion(rdfs:comment time:day "Posición de día en un sistema calendario-reloj."@es)
    AnnotationAssertion(rdfs:comment time:dayOfWeek "El día de la semana, cuyo valor es un miembro de la clase 'día de la semana'."^^xsd:string)
    AnnotationAssertion(rdfs:comment time:dayOfWeek "The day of week, whose value is a member of the class time:DayOfWeek"@en)
    AnnotationAssertion(rdfs:comment time:dayOfYear "El número de día en el año."@es)
    AnnotationAssertion(rdfs:comment time:dayOfYear "The number of the day within the year"@en)
    AnnotationAssertion(rdfs:comment time:days "Longitud de, o elemento de la longitud de, una extensión temporal expresada en días."@es)
    AnnotationAssertion(rdfs:comment time:days "length of, or element of the length of, a temporal extent expressed in days"@en)
    AnnotationAssertion(rdfs:comment time:generalDay "Day of month - formulated as a text string with a pattern constraint to reproduce the same lexical form as gDay, except that values up to 99 are permitted, in order to support calendars with more than 31 days in a month. \nNote that the value-space is not defined, so a generic OWL2 processor cannot compute ordering relationships of values of this type."@en)
    AnnotationAssertion(rdfs:comment time:generalDay "Día del mes - formulado como una cadena de texto con una restricción patrón para reproducir la misma forma léxica que gDay, excepto que se permiten valores hasta el 99, con el propósito de proporcionar soporte a calendarios con meses con más de 31 días.\n            Nótese que el espacio de valores no está definido, por tanto, un procesador genérico de OWL2 no puede computar relaciones de orden de valores de este tipo."@es)
    AnnotationAssertion(rdfs:comment time:generalMonth "Mes del año - formulado como una cadena de texto con una restricción patrón para reproducir la misma forma léxica que gMonth, excepto que se permiten valores hasta el 20, con el propósito de proporcionar soporte a calendarios con años con más de 12 meses.\n            Nótese que el espacio de valores no está definido, por tanto, un procesador genérico de OWL2 no puede computar relaciones de orden de valores de este tipo."@es)
    AnnotationAssertion(rdfs:comment time:generalMonth "Month of year - formulated as a text string with a pattern constraint to reproduce the same lexical form as gMonth, except that values up to 20 are permitted, in order to support calendars with more than 12 months in the year. \nNote that the value-space is not defined, so a generic OWL2 processor cannot compute ordering relationships of values of this type."@en)
    AnnotationAssertion(rdfs:comment time:generalYear "Número de año - formulado como una cadena de texto con una restricción patrón para reproducir la misma forma léxica que gYear, aunque no está restringido a valores del calendario gregoriano.\n            Nótese que el espacio de valores no está definido, por tanto, un procesador genérico de OWL2 no puede computar relaciones de orden de valores de este tipo."@es)
    AnnotationAssertion(rdfs:comment time:generalYear "Year number - formulated as a text string with a pattern constraint to reproduce the same lexical form as gYear, but not restricted to values from the Gregorian calendar. \nNote that the value-space is not defined, so a generic OWL2 processor cannot compute ordering relationships of values of this type."@en)
    AnnotationAssertion(rdfs:comment time:hasBeginning "Beginning of a temporal entity"@en)
    AnnotationAssertion(rdfs:comment time:hasBeginning "Comienzo de una entidad temporal."@es)
    AnnotationAssertion(rdfs:comment time:hasDateTimeDescription "Valor de intervalo de fecha-hora expresado como un valor estructurado. El principio y el final del intervalo coincide con los límites del elemento más corto en la descripción."@es)
    AnnotationAssertion(rdfs:comment time:hasDateTimeDescription "Value of DateTimeInterval expressed as a structured value. The beginning and end of the interval coincide with the limits of the shortest element in the description."@en)
    AnnotationAssertion(rdfs:comment time:hasDuration "Duración de una entidad temporal, expresada como un valor escalado o un valor nominal."@es)
    AnnotationAssertion(rdfs:comment time:hasDuration "Duration of a temporal entity, expressed as a scaled value or nominal value"@en)
    AnnotationAssertion(rdfs:comment time:hasDurationDescription "Duración de una entidad temporal, expresada utilizando una descripción estructurada."@es)
    AnnotationAssertion(rdfs:comment time:hasDurationDescription "Duration of a temporal entity, expressed using a structured description"@en)
    AnnotationAssertion(rdfs:comment time:hasEnd "End of a temporal entity."@en)
    AnnotationAssertion(rdfs:comment time:hasEnd "Final de una entidad temporal."@es)
    AnnotationAssertion(rdfs:comment time:hasTRS "El sistema de referencia temporal utilizado por una posición temporal o descripción de extensión."@es)
    AnnotationAssertion(rdfs:comment time:hasTRS "The temporal reference system used by a temporal position or extent description. "@en)
    AnnotationAssertion(rdfs:comment time:hasTemporalDuration "Duración de una entidad temporal."@es)
    AnnotationAssertion(rdfs:comment time:hasTemporalDuration "Duration of a temporal entity."@en)
    AnnotationAssertion(rdfs:comment time:hasTime "Proporciona soporte a la asociación de una entidad temporal (instante o intervalo) a cualquier cosa."@es)
    AnnotationAssertion(rdfs:comment time:hasTime "Supports the association of a temporal entity (instant or interval) to any thing"@en)
    AnnotationAssertion(rdfs:comment time:hasXSDDuration "Extensión de una entidad temporal, expresada utilizando xsd:duration."@es)
    AnnotationAssertion(rdfs:comment time:hasXSDDuration "Extent of a temporal entity, expressed using xsd:duration"@en)
    AnnotationAssertion(rdfs:comment time:hour "Hour position in a calendar-clock system."@en)
    AnnotationAssertion(rdfs:comment time:hour "Posición de hora en un sistema calendario-reloj."@es)
    AnnotationAssertion(rdfs:comment time:hours "Longitud de, o elemento de la longitud de, una extensión temporal expresada en horas."@es)
    AnnotationAssertion(rdfs:comment time:hours "length of, or element of the length of, a temporal extent expressed in hours"@en)
    AnnotationAssertion(rdfs:comment time:inDateTime "Posición de un instante, expresada utilizando una descripción estructurada."@es)
    AnnotationAssertion(rdfs:comment time:inDateTime "Position of an instant, expressed using a structured description"@en)
    AnnotationAssertion(rdfs:comment time:inTemporalPosition "Posición de un instante de tiempo."@es)
    AnnotationAssertion(rdfs:comment time:inTemporalPosition "Position of a time instant"@en)
    AnnotationAssertion(rdfs:comment time:inTimePosition "Posición de un instante, expresada como una coordenada temporal o un valor nominal."@es)
    AnnotationAssertion(rdfs:comment time:inTimePosition "Position of an instant, expressed as a temporal coordinate or nominal value"@en)
    AnnotationAssertion(rdfs:comment time:inXSDDate "Posición de un instante, expresado utilizando xsd:date."@es)
    AnnotationAssertion(rdfs:comment time:inXSDDate "Position of an instant, expressed using xsd:date"@en)
    AnnotationAssertion(rdfs:comment time:inXSDDateTime "Posición de un instante, expresado utilizando xsd:dateTime."@es)
    AnnotationAssertion(rdfs:comment time:inXSDDateTime "Position of an instant, expressed using xsd:dateTime"@en)
    AnnotationAssertion(rdfs:comment time:inXSDDateTimeStamp "Posición de un instante, expresado utilizando xsd:dateTimeStamp."@es)
    AnnotationAssertion(rdfs:comment time:inXSDDateTimeStamp "Position of an instant, expressed using xsd:dateTimeStamp"@en)
    AnnotationAssertion(rdfs:comment time:inXSDgYear "Posición de un instante, expresado utilizando xsd:gYear."@es)
    AnnotationAssertion(rdfs:comment time:inXSDgYear "Position of an instant, expressed using xsd:gYear"@en)
    AnnotationAssertion(rdfs:comment time:inXSDgYearMonth "Posición de un instante, expresado utilizando xsd:gYearMonth."@es)
    AnnotationAssertion(rdfs:comment time:inXSDgYearMonth "Position of an instant, expressed using xsd:gYearMonth"@en)
    AnnotationAssertion(rdfs:comment time:inside "An instant that falls inside the interval. It is not intended to include beginnings and ends of intervals."@en)
    AnnotationAssertion(rdfs:comment time:inside "Un instante que cae dentro del intervalo. Se asume que no es ni el principio ni el final de ningún intervalo."@es)
    AnnotationAssertion(rdfs:comment time:intervalAfter "If a proper interval T1 is intervalAfter another proper interval T2, then the beginning of T1 is after the end of T2."@en)
    AnnotationAssertion(rdfs:comment time:intervalAfter "Si un intervalo propio T1 es posterior a otro intervalo propio T2, entonces el principio de T1 está después que el final de T2."^^xsd:string)
    AnnotationAssertion(rdfs:comment time:intervalBefore "If a proper interval T1 is intervalBefore another proper interval T2, then the end of T1 is before the beginning of T2."@en)
    AnnotationAssertion(rdfs:comment time:intervalBefore "Si un intervalo propio T1 está antes que otro intervalo propio T2, entonces el final de T1 está antes que el principio de T2."@es)
    AnnotationAssertion(rdfs:comment time:intervalContains "If a proper interval T1 is intervalContains another proper interval T2, then the beginning of T1 is before the beginning of T2, and the end of T1 is after the end of T2."@en)
    AnnotationAssertion(rdfs:comment time:intervalContains "Si un intervalo propio T1 contiene otro intervalo propio T2, entonces el principio de T1 está antes que el principio de T2, y el final de T1 está después del final de T2."@es)
    AnnotationAssertion(rdfs:comment time:intervalDisjoint "If a proper interval T1 is intervalDisjoint another proper interval T2, then the beginning of T1 is after the end of T2, or the end of T1 is before the beginning of T2, i.e. the intervals do not overlap in any way, but their ordering relationship is not known."@en)
    AnnotationAssertion(rdfs:comment time:intervalDisjoint "Si un intervalo propio T1 es disjunto con otro intervalo propio T2, entonces el principio de T1 está después del final de T2, o el final de T1 está antes que el principio de T2, es decir, los intervalos no se solapan de ninguna forma, aunque su relación de orden no se conozca."@es)
    AnnotationAssertion(rdfs:comment time:intervalDuring "If a proper interval T1 is intervalDuring another proper interval T2, then the beginning of T1 is after the beginning of T2, and the end of T1 is before the end of T2."@en)
    AnnotationAssertion(rdfs:comment time:intervalDuring "Si un intervalo propio T1 está durante otro intervalo propio T2, entonces del principio de T1 está después del principio de T2, y el final de T1 está antes que el final de T2."@es)
    AnnotationAssertion(rdfs:comment time:intervalEquals "If a proper interval T1 is intervalEquals another proper interval T2, then the beginning of T1 is coincident with the beginning of T2, and the end of T1 is coincident with the end of T2."@en)
    AnnotationAssertion(rdfs:comment time:intervalEquals "Si un intervalo propio T1 es igual a otro intervalo propio T2, entonces el principio de T1 coincide con el principio de T2, y el final de T1 coincide con el final de T2."@es)
    AnnotationAssertion(rdfs:comment time:intervalFinishedBy "If a proper interval T1 is intervalFinishedBy another proper interval T2, then the beginning of T1 is before the beginning of T2, and the end of T1 is coincident with the end of T2."@en)
    AnnotationAssertion(rdfs:comment time:intervalFinishedBy "Si un intervalo propio T1 está terminado por otro intervalo propio T2, entonces el principio de T1 está antes que el principio de T2, y el final de T1 coincide con el final de T2."@es)
    AnnotationAssertion(rdfs:comment time:intervalFinishes "If a proper interval T1 is intervalFinishes another proper interval T2, then the beginning of T1 is after the beginning of T2, and the end of T1 is coincident with the end of T2."@en)
    AnnotationAssertion(rdfs:comment time:intervalFinishes "Si un intervalo propio T1 termina otro intervalo propio T2, entonces del principio de T1 está después del principio de T2, y el final de T1 coincide con el final de T2."@es)
    AnnotationAssertion(rdfs:comment time:intervalIn "If a proper interval T1 is intervalIn another proper interval T2, then the beginning of T1 is after the beginning of T2 or is coincident with the beginning of T2, and the end of T1 is before the end of T2, or is coincident with the end of T2, except that end of T1 may not be coincident with the end of T2 if the beginning of T1 is coincident with the beginning of T2."@en)
    AnnotationAssertion(rdfs:comment time:intervalIn "Si un intervalo propio T1 es un intervalo interior a otro intervalo propio T2, entonces el principio de T1 está después del principio de T2 o coincide con el principio de T2, y el final de T1 está antes que el final de T2, o coincide con el final de T2, excepto que el final de T1 puede no coincidir con el final de T2 si el principio de T1 coincide con el principio de T2."@es)
    AnnotationAssertion(rdfs:comment time:intervalMeets "If a proper interval T1 is intervalMeets another proper interval T2, then the end of T1 is coincident with the beginning of T2."@en)
    AnnotationAssertion(rdfs:comment time:intervalMeets "Si un intervalo propio T1 se encuentra con otro intervalo propio T2, entonces el final de T1 coincide con el principio de T2."@es)
    AnnotationAssertion(rdfs:comment time:intervalMetBy "If a proper interval T1 is intervalMetBy another proper interval T2, then the beginning of T1 is coincident with the end of T2."@en)
    AnnotationAssertion(rdfs:comment time:intervalMetBy "Si un intervalo propio T1 es 'intervalo encontrado por' otro intervalo propio T2, entonces el principio de T1 coincide con el final de T2."@es)
    AnnotationAssertion(rdfs:comment time:intervalOverlappedBy "If a proper interval T1 is intervalOverlappedBy another proper interval T2, then the beginning of T1 is after the beginning of T2, the beginning of T1 is before the end of T2, and the end of T1 is after the end of T2."@en)
    AnnotationAssertion(rdfs:comment time:intervalOverlappedBy "Si un intervalo propio T1 es 'intervalo solapado por' otro intervalo propio T2, entonces el principio de T1 es posterior al principio de T2, y el principio de T1 es anterior al final de T2, y el final de T1 es posterior al final de T2."@es)
    AnnotationAssertion(rdfs:comment time:intervalOverlaps "Asume una dirección en el tiempo. Si una entidad temporal T1 está después de otra entidad temporal T2, entonces el principio de T1 está después del final de T2."@es)
    AnnotationAssertion(rdfs:comment time:intervalOverlaps "If a proper interval T1 is intervalOverlaps another proper interval T2, then the beginning of T1 is before the beginning of T2, the end of T1 is after the beginning of T2, and the end of T1 is before the end of T2."@en)
    AnnotationAssertion(rdfs:comment time:intervalOverlaps "Si un intervalo propio T1 se solapa con otro intervalo propio T2, entonces el principio de T1 es anterior al principio de T2, el final de T1 es posterior al principio de T2, y el final de T1 es anterior al final de T2."@es)
    AnnotationAssertion(rdfs:comment time:intervalStartedBy "If a proper interval T1 is intervalStarted another proper interval T2, then the beginning of T1 is coincident with the beginning of T2, and the end of T1 is after the end of T2."@en)
    AnnotationAssertion(rdfs:comment time:intervalStartedBy "Si un intervalo propio T1 es empezado por otro intervalo propio T2, entonces el principio de T1 coincide con el principio de T2, y el final de T1 es posterior al final de T2."@es)
    AnnotationAssertion(rdfs:comment time:intervalStarts "If a proper interval T1 is intervalStarts another proper interval T2, then the beginning of T1 is coincident with the beginning of T2, and the end of T1 is before the end of T2."@en)
    AnnotationAssertion(rdfs:comment time:intervalStarts "Si un intervalo propio T1 empieza otro intervalo propio T2, entonces del principio de T1 con el principio de T2, y el final de T1 es anterior al final de T2."@es)
    AnnotationAssertion(rdfs:comment time:minute "Minute position in a calendar-clock system."@en)
    AnnotationAssertion(rdfs:comment time:minute "Posición de minuto en un sistema calendario-reloj."@es)
    AnnotationAssertion(rdfs:comment time:minutes "Longitud de, o elemento de la longitud de, una extensión temporal expresada en minutos."@es)
    AnnotationAssertion(rdfs:comment time:minutes "length, or element of, a temporal extent expressed in minutes"@en)
    AnnotationAssertion(rdfs:comment time:month "Month position in a calendar-clock system.\n\nThe range of this property is not specified, so can be replaced by any specific representation of a calendar month from any calendar. "@en)
    AnnotationAssertion(rdfs:comment time:month "Posición de mes en un sistema calendario-reloj.\n    El rango de esta propiedad no está especificado, por tanto, se puede reemplazar por cualquier representación específica de un mes de calendario de un calendario cualquiera."@es)
    AnnotationAssertion(rdfs:comment time:monthOfYear "El mes del año, cuyo valor es un miembro de la clase 'mes del año'."@es)
    AnnotationAssertion(rdfs:comment time:monthOfYear "The month of the year, whose value is a member of the class time:MonthOfYear"@en)
    AnnotationAssertion(rdfs:comment time:months "Longitud de, o elemento de la longitud de, una extensión temporal expresada en meses."@es)
    AnnotationAssertion(rdfs:comment time:months "length of, or element of the length of, a temporal extent expressed in months"@en)
