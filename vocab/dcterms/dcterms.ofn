    AnnotationAssertion(rdfs:comment dcterms:Agent "A resource that acts or has the power to act."@en)
    AnnotationAssertion(rdfs:comment dcterms:AgentClass "A group of agents."@en)
    AnnotationAssertion(rdfs:comment dcterms:BibliographicResource "A book, article, or other documentary resource."@en)
    AnnotationAssertion(rdfs:comment dcterms:Box "The set of regions in space defined by their geographic coordinates according to the DCMI Box Encoding Scheme."@en)
    AnnotationAssertion(rdfs:comment dcterms:DCMIType "The set of classes specified by the DCMI Type Vocabulary, used to categorize the nature or genre of the resource."@en)
    AnnotationAssertion(rdfs:comment dcterms:DDC "The set of conceptual resources specified by the Dewey Decimal Classification."@en)
    AnnotationAssertion(rdfs:comment dcterms:FileFormat "A digital resource format."@en)
    AnnotationAssertion(rdfs:comment dcterms:Frequency "A rate at which something recurs."@en)
    AnnotationAssertion(rdfs:comment dcterms:IMT "The set of media types specified by the Internet Assigned Numbers Authority."@en)
    AnnotationAssertion(rdfs:comment dcterms:ISO3166 "The set of codes listed in ISO 3166-1 for the representation of names of countries."@en)
    AnnotationAssertion(rdfs:comment dcterms:ISO639-2 "The three-letter alphabetic codes listed in ISO639-2 for the representation of names of languages."@en)
    AnnotationAssertion(rdfs:comment dcterms:ISO639-3 "The set of three-letter codes listed in ISO 639-3 for the representation of names of languages."@en)
    AnnotationAssertion(rdfs:comment dcterms:Jurisdiction "The extent or range of judicial, law enforcement, or other authority."@en)
    AnnotationAssertion(rdfs:comment dcterms:LCC "The set of conceptual resources specified by the Library of Congress Classification."@en)
    AnnotationAssertion(rdfs:comment dcterms:LCSH "The set of labeled concepts specified by the Library of Congress Subject Headings."@en)
    AnnotationAssertion(rdfs:comment dcterms:LicenseDocument "A legal document giving official permission to do something with a resource."@en)
    AnnotationAssertion(rdfs:comment dcterms:LinguisticSystem "A system of signs, symbols, sounds, gestures, or rules used in communication."@en)
    AnnotationAssertion(rdfs:comment dcterms:Location "A spatial region or named place."@en)
