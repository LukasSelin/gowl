    AnnotationAssertion(dcam:rangeIncludes dcterms:contributor dcterms:Agent)
    AnnotationAssertion(dcam:rangeIncludes dcterms:coverage dcterms:Jurisdiction)
    AnnotationAssertion(dcam:rangeIncludes dcterms:coverage dcterms:Location)
    AnnotationAssertion(dcam:rangeIncludes dcterms:coverage dcterms:Period)
    AnnotationAssertion(dcam:rangeIncludes dcterms:creator dcterms:Agent)
    AnnotationAssertion(dcam:rangeIncludes dcterms:educationLevel dcterms:AgentClass)
