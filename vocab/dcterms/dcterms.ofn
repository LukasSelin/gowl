Ontology(<http://purl.org/dc/terms/>
    Annotation(dcterms:modified "2012-06-14"^^xsd:date)
    Annotation(dcterms:publisher <http://purl.org/dc/aboutdcmi#DCMI>)
    Annotation(dcterms:title "DCMI Metadata Terms - other"@en)
    AnnotationAssertion(dcam:domainIncludes dcterms:medium dcterms:PhysicalResource)
    AnnotationAssertion(dcam:rangeIncludes dcterms:accessRights dcterms:RightsStatement)
    AnnotationAssertion(dcam:rangeIncludes dcterms:accrualMethod dcterms:MethodOfAccrual)
    AnnotationAssertion(dcam:rangeIncludes dcterms:accrualPeriodicity dcterms:Frequency)
    AnnotationAssertion(dcam:rangeIncludes dcterms:accrualPolicy dcterms:Policy)
    AnnotationAssertion(dcam:rangeIncludes dcterms:audience dcterms:AgentClass)
