    Annotation(dc:date "2019-12-16"^^xsd:string)
    Annotation(dc:description "This is the RDF Schema for the RDF vocabulary terms in the RDF Namespace, defined in RDF 1.1 Concepts."^^xsd:string)
    Annotation(dc:title "The RDF Concepts Vocabulary (RDF)"^^xsd:string)
    AnnotationAssertion(rdfs:comment rdf:Alt "The class of containers of alternatives."^^xsd:string)
    AnnotationAssertion(rdfs:comment rdf:Bag "The class of unordered containers."^^xsd:string)
    AnnotationAssertion(rdfs:comment rdf:CompoundLiteral "A class representing a compound literal."^^xsd:string)
    AnnotationAssertion(rdfs:comment rdf:HTML "The datatype of RDF literals storing fragments of HTML content"^^xsd:string)
    AnnotationAssertion(rdfs:comment rdf:JSON "The datatype of RDF literals storing JSON content."^^xsd:string)
    AnnotationAssertion(rdfs:comment rdf:List "The class of RDF Lists."^^xsd:string)
    AnnotationAssertion(rdfs:comment rdf:PlainLiteral "The class of plain (i.e. untyped) literal values, as used in RIF and OWL 2"^^xsd:string)
    AnnotationAssertion(rdfs:comment rdf:Property "The class of RDF properties."^^xsd:string)
    AnnotationAssertion(rdfs:comment rdf:Seq "The class of ordered containers."^^xsd:string)
    AnnotationAssertion(rdfs:comment rdf:Statement "The class of RDF statements."^^xsd:string)
    AnnotationAssertion(rdfs:comment rdf:XMLLiteral "The datatype of XML literal values."^^xsd:string)
    AnnotationAssertion(rdfs:comment rdf:direction "The base direction component of a CompoundLiteral."^^xsd:string)
    AnnotationAssertion(rdfs:comment rdf:first "The first item in the subject RDF list."^^xsd:string)
    AnnotationAssertion(rdfs:comment rdf:langString "The datatype of language-tagged string values"^^xsd:string)
    AnnotationAssertion(rdfs:comment rdf:language "The language component of a CompoundLiteral."^^xsd:string)
    AnnotationAssertion(rdfs:comment rdf:nil "The empty list, with no items in it. If the rest of a list is nil then the list has no more items in it."^^xsd:string)
    AnnotationAssertion(rdfs:comment rdf:object "The object of the subject RDF statement."^^xsd:string)
    AnnotationAssertion(rdfs:comment rdf:predicate "The predicate of the subject RDF statement."^^xsd:string)
    AnnotationAssertion(rdfs:comment rdf:rest "The rest of the subject RDF list after the first item."^^xsd:string)
    AnnotationAssertion(rdfs:comment rdf:subject "The subject of the subject RDF statement."^^xsd:string)
    AnnotationAssertion(rdfs:comment rdf:type "The subject is an instance of a class."^^xsd:string)
    AnnotationAssertion(rdfs:comment rdf:value "Idiomatic property used for structured values."^^xsd:string)
