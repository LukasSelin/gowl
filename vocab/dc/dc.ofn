    AnnotationAssertion(dcterms:title <http://purl.org/dc/elements/1.1/> "Dublin Core Metadata Element Set, Version 1.1"@en)
    AnnotationAssertion(rdfs:comment dc:contributor "An entity responsible for making contributions to the resource."@en)
    AnnotationAssertion(rdfs:comment dc:coverage "The spatial or temporal topic of the resource, spatial applicability of the resource, or jurisdiction under which the resource is relevant."@en)
    AnnotationAssertion(rdfs:comment dc:creator "An entity primarily responsible for making the resource."@en)
    AnnotationAssertion(rdfs:comment dc:date "A point or period of time associated with an event in the lifecycle of the resource."@en)
    AnnotationAssertion(rdfs:comment dc:description "An account of the resource."@en)
    AnnotationAssertion(rdfs:comment dc:format "The file format, physical medium, or dimensions of the resource."@en)
    AnnotationAssertion(rdfs:comment dc:identifier "An unambiguous reference to the resource within a given context."@en)
    AnnotationAssertion(rdfs:comment dc:language "A language of the resource."@en)
    AnnotationAssertion(rdfs:comment dc:publisher "An entity responsible for making the resource available."@en)
    AnnotationAssertion(rdfs:comment dc:relation "A related resource."@en)
    AnnotationAssertion(rdfs:comment dc:rights "Information about rights held in and over the resource."@en)
    AnnotationAssertion(rdfs:comment dc:source "A related resource from which the described resource is derived."@en)
    AnnotationAssertion(rdfs:comment dc:subject "The topic of the resource."@en)
    AnnotationAssertion(rdfs:comment dc:title "A name given to the resource."@en)
    AnnotationAssertion(rdfs:comment dc:type "The nature or genre of the resource."@en)
