Prefix(dc:=<http://purl.org/dc/elements/1.1/>)
Prefix(foaf:=<http://xmlns.com/foaf/0.1/>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(vs:=<http://www.w3.org/2003/06/sw-vocab-status/ns#>)
Prefix(wot:=<http://xmlns.com/wot/0.1/>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)

Ontology(<http://xmlns.com/foaf/0.1/>
    Annotation(dc:description "The Friend of a Friend (FOAF) RDF vocabulary, described using W3C RDF Schema and the Web Ontology Language."^^xsd:string)
    Annotation(dc:title "Friend of a Friend (FOAF) vocabulary"^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:Agent "An agent (eg. person, group, software or physical artifact)."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:Document "A document."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:Group "A class of Agents."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:Image "An image."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:LabelProperty "A foaf:LabelProperty is any RDF property with texual values that serve as labels."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:OnlineAccount "An online account."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:OnlineChatAccount "An online chat account."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:OnlineEcommerceAccount "An online e-commerce account."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:OnlineGamingAccount "An online gaming account."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:Organization "An organization."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:Person "A person."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:PersonalProfileDocument "A personal profile RDF document."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:Project "A project (a collective endeavour of some kind)."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:account "Indicates an account held by this agent."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:accountName "Indicates the name (identifier) associated with this online account."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:accountServiceHomepage "Indicates a homepage of the service provide for this online account."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:age "The age in years of some agent."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:aimChatID "An AIM chat ID"^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:based_near "A location that something is based near, for some broadly human notion of near."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:birthday "The birthday of this Agent, represented in mm-dd string form, eg. '12-31'."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:currentProject "A current project this person works on."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:depiction "A depiction of some thing."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:depicts "A thing depicted in this representation."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:dnaChecksum "A checksum for the DNA of some thing. Joke."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:familyName "The family name of some person."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:family_name "The family name of some person."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:firstName "The first name of a person."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:focus "The underlying or 'focal' entity associated with some SKOS-described concept."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:fundedBy "An organization funding a project or person."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:geekcode "A textual geekcode for this person, see http://www.geekcode.com/geek.html"^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:gender "The gender of this Agent (typically but not necessarily 'male' or 'female')."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:givenName "The given name of some person."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:givenname "The given name of some person."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:holdsAccount "Indicates an account held by this agent."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:homepage "A homepage for some thing."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:icqChatID "An ICQ chat ID"^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:img "An image that can be used to represent some thing (ie. those depictions which are particularly representative of something, eg. one's photo on a homepage)."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:interest "A page about a topic of interest to this person."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:isPrimaryTopicOf "A document that this thing is the primary topic of."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:jabberID "A jabber ID for something."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:knows "A person known by this person (indicating some level of reciprocated interaction between the parties)."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:lastName "The last name of a person."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:logo "A logo representing some thing."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:made "Something that was made by this agent."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:maker "An agent that \nmade this thing."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:mbox "A \npersonal mailbox, ie. an Internet mailbox associated with exactly one owner, the first owner of this mailbox. This is a 'static inverse functional property', in that  there is (across time and change) at most one individual that ever has any particular value for foaf:mbox."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:mbox_sha1sum "The sha1sum of the URI of an Internet mailbox associated with exactly one owner, the  first owner of the mailbox."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:member "Indicates a member of a Group"^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:membershipClass "Indicates the class of individuals that are a member of a Group"^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:msnChatID "An MSN chat ID"^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:myersBriggs "A Myers Briggs (MBTI) personality classification."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:name "A name for some thing."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:nick "A short informal nickname characterising an agent (includes login identifiers, IRC and other chat nicknames)."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:openid "An OpenID for an Agent."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:page "A page or document about this thing."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:pastProject "A project this person has previously worked on."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:phone "A phone,  specified using fully qualified tel: URI scheme (refs: http://www.w3.org/Addressing/schemes.html#tel)."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:plan "A .plan comment, in the tradition of finger and '.plan' files."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:primaryTopic "The primary topic of some page or document."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:publications "A link to the publications of this person."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:schoolHomepage "A homepage of a school attended by the person."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:sha1 "A sha1sum hash, in hex."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:skypeID "A Skype ID"^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:status "A string expressing what the user is happy for the general public (normally) to know about their current activity."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:surname "The surname of some person."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:theme "A theme."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:thumbnail "A derived thumbnail image."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:tipjar "A tipjar document for this agent, describing means for payment and reward."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:title "Title (Mr, Mrs, Ms, Dr. etc)"^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:topic "A topic of some page or document."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:topic_interest "A thing of interest to this person."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:weblog "A weblog of some thing (whether person, group, company etc.)."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:workInfoHomepage "A work info homepage of some person; a page about their work for some organization."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:workplaceHomepage "A workplace homepage of some person; the homepage of an organization they work for."^^xsd:string)
    AnnotationAssertion(rdfs:comment foaf:yahooChatID "A Yahoo chat ID"^^xsd:string)
    AnnotationAssertion(rdfs:isDefinedBy foaf:Document <http://xmlns.com/foaf/0.1/>)
    AnnotationAssertion(rdfs:isDefinedBy foaf:Image <http://xmlns.com/foaf/0.1/>)
