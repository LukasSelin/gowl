Prefix(dct:=<http://purl.org/dc/terms/>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(skos:=<http://www.w3.org/2004/02/skos/core#>)
Prefix(skosxl:=<http://www.w3.org/2008/05/skos-xl#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)

Ontology(<http://www.w3.org/2008/05/skos-xl>
    Import(<http://www.w3.org/2004/02/skos/core>)
    Annotation(dct:contributor "Participants in W3C's Semantic Web Deployment Working Group."^^xsd:string)
    Annotation(dct:creator "Alistair Miles"^^xsd:string)
    Annotation(dct:creator "Sean Bechhofer"^^xsd:string)
    Annotation(dct:description "An RDF vocabulary extending SKOS and allowing the description and linking of lexical entities."@en)
    Annotation(dct:title "SKOS XL Vocabulary"@en)
    Annotation(rdfs:seeAlso <http://www.w3.org/2008/05/skos>)
    AnnotationAssertion(rdfs:comment skosxl:altLabel "If C skosxl:altLabel L and L skosxl:literalForm V, then X skos:altLabel V."@en)
    AnnotationAssertion(rdfs:comment skosxl:hiddenLabel "If C skosxl:hiddenLabel L and L skosxl:literalForm V, then C skos:hiddenLabel V."@en)
    AnnotationAssertion(rdfs:comment skosxl:literalForm "If two instances of the class skosxl:Label have the same literal form, they are not necessarily the same resource."@en)
    AnnotationAssertion(rdfs:comment skosxl:literalForm "The range of skosxl:literalForm is the class of RDF plain literals."@en)
    AnnotationAssertion(rdfs:comment skosxl:prefLabel "If C skosxl:prefLabel L and L skosxl:literalForm V, then X skos:prefLabel V."@en)
    AnnotationAssertion(rdfs:isDefinedBy skosxl:Label <http://www.w3.org/2008/05/skos-xl>)
    AnnotationAssertion(rdfs:isDefinedBy skosxl:altLabel <http://www.w3.org/2008/05/skos-xl>)
    AnnotationAssertion(rdfs:isDefinedBy skosxl:hiddenLabel <http://www.w3.org/2008/05/skos-xl>)
    AnnotationAssertion(rdfs:isDefinedBy skosxl:labelRelation <http://www.w3.org/2008/05/skos-xl>)
    AnnotationAssertion(rdfs:isDefinedBy skosxl:literalForm <http://www.w3.org/2008/05/skos-xl>)
    AnnotationAssertion(rdfs:isDefinedBy skosxl:prefLabel <http://www.w3.org/2008/05/skos-xl>)
    AnnotationAssertion(rdfs:label skosxl:Label "Label"@en)
    AnnotationAssertion(rdfs:label skosxl:altLabel "alternative label"@en)
    AnnotationAssertion(rdfs:label skosxl:hiddenLabel "hidden label"@en)
    AnnotationAssertion(rdfs:label skosxl:labelRelation "label relation"@en)
    AnnotationAssertion(rdfs:label skosxl:literalForm "literal form"@en)
    AnnotationAssertion(rdfs:label skosxl:prefLabel "preferred label"@en)
    AnnotationAssertion(rdfs:seeAlso skosxl:altLabel skos:altLabel)
    AnnotationAssertion(rdfs:seeAlso skosxl:hiddenLabel skos:hiddenLabel)
    AnnotationAssertion(rdfs:seeAlso skosxl:prefLabel skos:prefLabel)
    AnnotationAssertion(skos:definition skosxl:Label "A special class of lexical entities."@en)
    AnnotationAssertion(skos:definition skosxl:altLabel "The property skosxl:altLabel is used to associate an skosxl:Label with a skos:Concept. The property is analogous to skos:altLabel."@en)
    AnnotationAssertion(skos:definition skosxl:hiddenLabel "The property skosxl:hiddenLabel is used to associate an skosxl:Label with a skos:Concept. The property is analogous to skos:hiddenLabel."@en)
    AnnotationAssertion(skos:definition skosxl:labelRelation "The property skosxl:labelRelation is used for representing binary ('direct') relations between instances of the class skosxl:Label."@en)
    AnnotationAssertion(skos:definition skosxl:literalForm "The property skosxl:literalForm is used to give the literal form of an skosxl:Label."@en)
    AnnotationAssertion(skos:definition skosxl:prefLabel "The property skosxl:prefLabel is used to associate an skosxl:Label with a skos:Concept. The property is analogous to skos:prefLabel."@en)
    AnnotationAssertion(skos:scopeNote skosxl:labelRelation "skosxl:labelRelation is not intended to be used directly, but rather as the basis for a design pattern which can be refined for more specific labeling scenarios."@en)
    DataPropertyDomain(skosxl:literalForm skosxl:Label)
    Declaration(Class(skosxl:Label))
    Declaration(DataProperty(skosxl:literalForm))
    Declaration(ObjectProperty(skosxl:altLabel))
    Declaration(ObjectProperty(skosxl:hiddenLabel))
    Declaration(ObjectProperty(skosxl:labelRelation))
    Declaration(ObjectProperty(skosxl:prefLabel))
    DisjointClasses(skosxl:Label skos:Collection)
    DisjointClasses(skosxl:Label skos:Concept)
    DisjointClasses(skosxl:Label skos:ConceptScheme)
    ObjectPropertyDomain(skosxl:labelRelation skosxl:Label)
    ObjectPropertyRange(skosxl:altLabel skosxl:Label)
    ObjectPropertyRange(skosxl:hiddenLabel skosxl:Label)
    ObjectPropertyRange(skosxl:labelRelation skosxl:Label)
    ObjectPropertyRange(skosxl:prefLabel skosxl:Label)
    SubClassOf(skosxl:Label DataExactCardinality(1 skosxl:literalForm))
    SymmetricObjectProperty(skosxl:labelRelation)
)
