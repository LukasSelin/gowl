{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/ontology-check.sh\" pre", "timeout": 120 },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/design-gate.sh\"", "timeout": 60 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/ontology-check.sh\" post", "timeout": 120, "statusMessage": "Linting and classifying the ontology" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/sprawl-check.sh\"", "timeout": 180, "statusMessage": "Comparing the module's types with the base commit" },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/conform-check.sh\"", "timeout": 180, "statusMessage": "Comparing the code with its plan" },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/invariants-check.sh\"", "timeout": 180, "statusMessage": "Checking the code against its invariants" }
        ]
      }
    ]
  }
}
