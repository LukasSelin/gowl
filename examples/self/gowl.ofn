Prefix(:=<https://github.com/LukasSelin/gowl/self#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)

Ontology(<https://github.com/LukasSelin/gowl/self>
    Annotation(rdfs:comment "gowl's own Go code, described as an OWL 2 ontology by examples/self."^^xsd:string)
    AnnotationAssertion(rdfs:comment :ExternalPackage "A package from outside the gowl module that one of its packages imports: part of the standard library, or of a dependency."^^xsd:string)
    AnnotationAssertion(rdfs:comment :Package "A Go package of the gowl module."^^xsd:string)
    AnnotationAssertion(rdfs:comment :definedIn "The package whose source declares the subject Go type."^^xsd:string)
    AnnotationAssertion(rdfs:comment :el.Classification "Classification is the saturated result of classifying an ontology."^^xsd:string)
    AnnotationAssertion(rdfs:comment :el.Option "Option configures [Classify]."^^xsd:string)
    AnnotationAssertion(rdfs:comment :gocode.Conformance "Conformance is how a module measures up against a plan: what was checked, what could not be, and where the two differ."^^xsd:string)
    AnnotationAssertion(rdfs:comment :gocode.Delta "Delta is what a change did to a module's types, as [Compare] sees it."^^xsd:string)
    AnnotationAssertion(rdfs:comment :icv.Report "Report is what checking facts against constraints found: what was checked, what broke, what could not be checked, and which terms had nothing in them."^^xsd:string)
    AnnotationAssertion(rdfs:comment :icv.Violation "Violation is a constraint the facts break, the individual that breaks it, and the edges to blame."^^xsd:string)
    AnnotationAssertion(rdfs:comment :imports "The subject package imports the object package directly. The object is a :Package or an :ExternalPackage."^^xsd:string)
    AnnotationAssertion(rdfs:comment :lint.Finding "Finding is one problem found in an ontology."^^xsd:string)
    AnnotationAssertion(rdfs:comment :lint.Rule "Rule is a named check."^^xsd:string)
    AnnotationAssertion(rdfs:comment :lint.Severity "Severity ranks a finding."^^xsd:string)
    AnnotationAssertion(rdfs:comment :main.Answer "Answer is what classification placed under one question class."^^xsd:string)
    AnnotationAssertion(rdfs:comment :main.Result "Result is the ontology Build produced and what went into it."^^xsd:string)
    AnnotationAssertion(rdfs:comment :method "A method the subject Go interface declares, as Name(parameter types) result types."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.Annotated "Annotated attaches annotations to another axiom, as in"^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.Annotation "Annotation attaches a value to a subject via an annotation property."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.AnnotationAssertion "AnnotationAssertion attaches an annotation to any IRI."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.AnnotationProperty "AnnotationProperty carries non-logical metadata such as labels and comments."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.AnnotationValue "AnnotationValue is the object of an annotation: an [IRI], a [Literal] or an [AnonymousIndividual]."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.AnonymousIndividual "AnonymousIndividual is an individual identified only by a local node ID."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.Axiom "Axiom is a statement asserted by an ontology."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.Class "Class is a named OWL class."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.ClassBuilder "ClassBuilder accumulates axioms about one class."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.ClassExpression "ClassExpression denotes a set of individuals."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.DataProperty "DataProperty relates individuals to literals."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.DataPropertyBuilder "DataPropertyBuilder accumulates axioms about one data property."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.DataPropertyExpression "DataPropertyExpression is a [DataProperty]."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.DataRange "DataRange denotes a set of literals."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.Datatype "Datatype is a named OWL datatype."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.DatatypeDefinition "DatatypeDefinition names a data range."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.DatatypeRestriction "DatatypeRestriction narrows a datatype with facets, e.g."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.Declaration "Declaration introduces an entity into the ontology's signature."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.Diff "Diff is the difference between two ontologies."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.DisjointClasses "DisjointClasses asserts that the operands share no instances."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.DisjointUnion "DisjointUnion asserts Class is exactly the union of pairwise disjoint operands."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.Entity "Entity is a named OWL 2 term: a class, datatype, object property, data property, annotation property or named individual."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.EquivalentClasses "EquivalentClasses asserts that all operands denote the same set."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.FacetRestriction "FacetRestriction constrains a datatype by one facet, such as [FacetMinInclusive]."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.HasKey "HasKey asserts that the listed properties uniquely identify instances of Class."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.IRI "IRI is an Internationalized Resource Identifier."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.Index "Index is a precomputed view of an ontology's axioms."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.Individual "Individual is a [NamedIndividual] or an [AnonymousIndividual]."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.IndividualBuilder "IndividualBuilder accumulates assertions about one individual."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.Kind "Kind identifies one of the six OWL 2 entity types."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.Literal "Literal is a typed or language-tagged data value."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.NamedIndividual "NamedIndividual is an individual identified by an IRI."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.Node "Node is any construct in the OWL 2 structural model: an IRI, an entity, a class expression, an axiom, an annotation, or an ontology."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.ObjectAllValuesFrom "ObjectAllValuesFrom is a universal restriction."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.ObjectComplementOf "ObjectComplementOf is the negation of a class expression."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.ObjectHasSelf "ObjectHasSelf holds of individuals related to themselves by Property."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.ObjectHasValue "ObjectHasValue restricts a property to one individual."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.ObjectIntersectionOf "ObjectIntersectionOf is the conjunction of its operands."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.ObjectInverseOf "ObjectInverseOf denotes the inverse of a named object property."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.ObjectOneOf "ObjectOneOf is an enumeration of individuals."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.ObjectProperty "ObjectProperty relates individuals to individuals."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.ObjectPropertyBuilder "ObjectPropertyBuilder accumulates axioms about one object property."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.ObjectPropertyExpression "ObjectPropertyExpression is an [ObjectProperty] or its [ObjectInverseOf]."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.ObjectSomeValuesFrom "ObjectSomeValuesFrom is an existential restriction."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.ObjectUnionOf "ObjectUnionOf is the disjunction of its operands."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.Ontology "Ontology is a container of axioms plus the metadata that names them: an IRI, an optional version IRI, imports, ontology annotations and a prefix table."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.Prefixes "Prefixes maps prefix names to namespace IRIs, expanding CURIEs such as \":Pizza\" or \"rdfs:label\" into absolute IRIs and abbreviating them back again for display."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.Profile "Profile is one of the OWL 2 profiles: sublanguages that trade expressivity for tractable reasoning."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.SubClassOf "SubClassOf asserts that every instance of Sub is an instance of Super."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.SubPropertyChainOf "SubPropertyChainOf asserts that composing Chain implies Super."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.Term "Term is one entry in a [Vocabulary]: an entity together with the names a caller is likely to know it by."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.UnknownTermsError "UnknownTermsError reports entities used outside the vocabulary."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.Violation "Violation is one reason an ontology falls outside a profile."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.Vocabulary "Vocabulary is the closed set of terms an ontology defines, in a form built for handing to something that must choose among them — a language model, a completion UI, a validator for externally supplied axioms."^^xsd:string)
    AnnotationAssertion(rdfs:comment :owl.VocabularyOption "VocabularyOption adjusts which entities [NewVocabulary] includes."^^xsd:string)
    AnnotationAssertion(rdfs:comment :package.gowl.cmd.gowl "Command gowl inspects OWL 2 ontologies written in functional syntax, and writes one describing a Go module's code."^^xsd:string)
    AnnotationAssertion(rdfs:comment :package.gowl.cmd.vocabgen "Command vocabgen generates the packages under vocab/ from the published vocabulary documents listed in sources.go."^^xsd:string)
    AnnotationAssertion(rdfs:comment :package.gowl.el "Package el classifies OWL 2 EL ontologies."^^xsd:string)
    AnnotationAssertion(rdfs:comment :package.gowl.examples.k8s "Command k8s describes the structure of Go types as an OWL 2 EL ontology that a reasoner can answer questions with, and is tried on Kubernetes' API types."^^xsd:string)
    AnnotationAssertion(rdfs:comment :package.gowl.examples.self "Command self describes gowl's own Go code as an OWL 2 ontology, so that the repository's linter has a real, non-toy ontology of this repository to run on."^^xsd:string)
    AnnotationAssertion(rdfs:comment :package.gowl.internal.gocode "Package gocode describes a Go module's code as an OWL 2 ontology."^^xsd:string)
    AnnotationAssertion(rdfs:comment :package.gowl.internal.icv "Package icv checks facts against constraints written as OWL 2 axioms, under the closed-world assumption: integrity constraint validation."^^xsd:string)
    AnnotationAssertion(rdfs:comment :package.gowl.internal.rdf "Package rdf reads RDF graphs from Turtle and RDF/XML."^^xsd:string)
    AnnotationAssertion(rdfs:comment :package.gowl.internal.rdfowl "Package rdfowl maps an RDF graph onto gowl's structural OWL model."^^xsd:string)
    AnnotationAssertion(rdfs:comment :package.gowl.internal.vocabgen "Package vocabgen writes a Go package for one published vocabulary."^^xsd:string)
    AnnotationAssertion(rdfs:comment :package.gowl.lint "Package lint checks ontologies against structural policy: conventions and hygiene rules that hold regardless of what the ontology means."^^xsd:string)
    AnnotationAssertion(rdfs:comment :package.gowl.owl "Package owl provides a typed, in-memory representation of OWL 2 ontologies together with an idiomatic Go DSL for building and inspecting them."^^xsd:string)
    AnnotationAssertion(rdfs:comment :package.gowl.vocab.dc "Package dc is the Dublin Core Metadata Element Set as OWL entities."^^xsd:string)
    AnnotationAssertion(rdfs:comment :package.gowl.vocab.dcat "Package dcat is the Data Catalog Vocabulary as OWL entities."^^xsd:string)
    AnnotationAssertion(rdfs:comment :package.gowl.vocab.dcterms "Package dcterms is the DCMI Metadata Terms as OWL entities."^^xsd:string)
    AnnotationAssertion(rdfs:comment :package.gowl.vocab.foaf "Package foaf is the FOAF vocabulary as OWL entities."^^xsd:string)
    AnnotationAssertion(rdfs:comment :package.gowl.vocab.org "Package org is the Organization Ontology as OWL entities."^^xsd:string)
    AnnotationAssertion(rdfs:comment :package.gowl.vocab.prov "Package prov is the PROV-O provenance ontology as OWL entities."^^xsd:string)
    AnnotationAssertion(rdfs:comment :package.gowl.vocab.rdf "Package rdf is the RDF vocabulary as OWL entities."^^xsd:string)
    AnnotationAssertion(rdfs:comment :package.gowl.vocab.rdfs "Package rdfs is the RDF Schema vocabulary as OWL entities."^^xsd:string)
    AnnotationAssertion(rdfs:comment :package.gowl.vocab.schema "Package schema is the Schema.org vocabulary as OWL entities."^^xsd:string)
    AnnotationAssertion(rdfs:comment :package.gowl.vocab.skos "Package skos is the SKOS Core vocabulary as OWL entities."^^xsd:string)
    AnnotationAssertion(rdfs:comment :package.gowl.vocab.skosxl "Package skosxl is the SKOS eXtension for Labels as OWL entities."^^xsd:string)
    AnnotationAssertion(rdfs:comment :package.gowl.vocab.time "Package time is the OWL-Time ontology as OWL entities."^^xsd:string)
    AnnotationAssertion(rdfs:comment :package.gowl.vocab "Package vocab is the index of the vocabularies gowl ships."^^xsd:string)
    AnnotationAssertion(rdfs:comment :rdf.Blank "Blank is a blank node, identified by a label unique within one parse."^^xsd:string)
    AnnotationAssertion(rdfs:comment :rdf.Graph "A Graph is a parsed document: its triples, plus the prefixes the document declared."^^xsd:string)
    AnnotationAssertion(rdfs:comment :rdf.IRI "IRI is an absolute IRI."^^xsd:string)
    AnnotationAssertion(rdfs:comment :rdf.Literal "Literal is a string value with either a datatype or a language tag."^^xsd:string)
    AnnotationAssertion(rdfs:comment :rdf.Term "A Term is one position in a triple: an IRI, a blank node or a literal."^^xsd:string)
    AnnotationAssertion(rdfs:comment :rdf.Triple "Triple is one statement."^^xsd:string)
    AnnotationAssertion(rdfs:comment :rdfowl.Options "Options configures one conversion."^^xsd:string)
    AnnotationAssertion(rdfs:comment :rdfowl.Result "Result is a converted graph."^^xsd:string)
    AnnotationAssertion(rdfs:comment :rdfowl.Skip "Skip records a triple the mapping had no structural reading for and did not turn into an annotation either."^^xsd:string)
    AnnotationAssertion(rdfs:comment :vocab.Entry "An Entry is one vocabulary."^^xsd:string)
    AnnotationAssertion(rdfs:comment :vocabgen.Files "Files is what a generation produced."^^xsd:string)
    AnnotationAssertion(rdfs:comment :vocabgen.Package "A Package is one vocabulary to generate."^^xsd:string)
